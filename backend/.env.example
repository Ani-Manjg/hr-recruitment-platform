NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-at-least-32-random-secret
TOKEN_HASH_SECRET=replace-with-a-third-at-least-32-random-secret

BREVO_API_KEY=xkeysib-replace-with-your-brevo-api-key
EMAIL_FROM=your-verified-sender@example.com
EMAIL_FROM_NAME=TalentFlow HR
PASSWORD_RESET_URL=http://localhost:5173/login

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
CANDIDATE_RETENTION_DAYS=365
